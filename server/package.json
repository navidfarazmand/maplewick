{
  "name": "maplewick-server",
  "private": true,
  "description": "Deploys and tests Maplewick's server. The functions themselves are in functions/.",
  "scripts": {
    "test": "cd functions && npm test",
    "test:emulator": "firebase emulators:exec --only firestore,functions,auth --project demo-maplewick \"node --test test/*.test.mjs\"",
    "deploy": "firebase deploy --only firestore:rules,functions --project maplewick-eb4df"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.0"
  }
}
